# Copy to .env and fill in. Never commit .env.
# Firebase web config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: enables Firebase Analytics (resume downloads, project opens, contact submits).
# Leave blank to disable all tracking. Do Not Track browsers are always skipped.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: URL of the deployed api/chat.js function (e.g. https://your-site.vercel.app/api/chat).
# When set, "Ask Aayush" answers with an LLM; otherwise it uses the built-in local answers.
# The function needs ANTHROPIC_API_KEY (and optionally ALLOWED_ORIGIN, CHAT_MODEL) set on the host.
VITE_CHAT_API_URL=

# Optional: your deployed origin, no trailing slash (e.g. https://your-domain.com).
# Adds canonical + og:url, absolute share-image URLs, sitemap.xml and a Sitemap line in robots.txt.
VITE_SITE_URL=
